<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kingfisher.modules.worktask.mapper.WorkTaskMapper">
    <resultMap id="WorkTaskMap" type="com.kingfisher.modules.worktask.domain.WorkTask">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="ownerId" column="owner_id"/>
        <result property="departmentId" column="department_id"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="whereClause">
        <where>
            <if test="scope != null and scope.type == 'self'">
                AND ${scope.field} = #{scope.value}
            </if>
            <if test="scope != null and (scope.type == 'department' or scope.type == 'subtree')">
                AND ${scope.field} IN
                <foreach collection="scope.ids" item="id" open="(" separator="," close=")">#{id}</foreach>
            </if>
            <if test="keyword != null and keyword != '' and searchableColumns != null">
                <foreach collection="searchableColumns" item="col" open=" AND (" separator=" OR " close=")">
                    ${col} LIKE '%' || #{keyword} || '%'
                </foreach>
            </if>
            <if test="filters != null">
                <foreach collection="filters" item="f">
                    <choose>
                        <when test="f.op.name() == 'EQ'"> AND ${f.field} = #{f.value}</when>
                        <when test="f.op.name() == 'NE'"> AND ${f.field} != #{f.value}</when>
                        <when test="f.op.name() == 'CONTAINS'"> AND ${f.field} LIKE '%' || #{f.value} || '%'</when>
                    </choose>
                </foreach>
            </if>
        </where>
    </sql>

    <select id="findAll" resultMap="WorkTaskMap">
        SELECT id, title, description, owner_id, department_id, status, created_at, updated_at
        FROM tasks
        <include refid="whereClause"/>
        ORDER BY
        <choose><when test="sort != null and sort != ''">${sort}</when><otherwise>id DESC</otherwise></choose>
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM tasks <include refid="whereClause"/>
    </select>

    <select id="findById" resultMap="WorkTaskMap">
        SELECT id, title, description, owner_id, department_id, status, created_at, updated_at
        FROM tasks WHERE id = #{id}
        <if test="scope != null and scope.type == 'self'"> AND ${scope.field} = #{scope.value}</if>
        <if test="scope != null and (scope.type == 'department' or scope.type == 'subtree')"> AND ${scope.field} IN
            <foreach collection="scope.ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        </if>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tasks (title, description, owner_id, department_id, status, created_at, updated_at)
        VALUES (#{title}, #{description}, #{ownerId}, #{departmentId}, #{status}, datetime('now'), datetime('now'))
    </insert>

    <update id="update">
        UPDATE tasks
        <set>
            <if test="updates.title != null">title = #{updates.title},</if>
            <if test="updates.description != null">description = #{updates.description},</if>
            <if test="updates.status != null">status = #{updates.status},</if>
            updated_at = datetime('now')
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM tasks WHERE id = #{id}
        <if test="scope != null and scope.type == 'self'"> AND ${scope.field} = #{scope.value}</if>
        <if test="scope != null and (scope.type == 'department' or scope.type == 'subtree')"> AND ${scope.field} IN
            <foreach collection="scope.ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        </if>
    </delete>
</mapper>
