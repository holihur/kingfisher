[Unit]
Description=Kingfisher Admin API + Frontend
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
# 部署目录 = Release 解压目录
WorkingDirectory=/root/kingfisher
Environment=CONFIG_PATH=/root/kingfisher/config.yaml
ExecStart=/root/kingfisher/kingfisher-server
Restart=always
RestartSec=5
# 生产 JWT secret 从 env 注入（release 模式强制要求，不能是占位值）
Environment=JWT_SECRET=please-change-me-in-production
# 资源限制（1.6G 小机器）
LimitNOFILE=65535
MemoryMax=1G

[Install]
WantedBy=multi-user.target
